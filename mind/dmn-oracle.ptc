;; MiS DMN oracle contract (P12 Phase A)
;; Mandatory preflight before any Chorus: unfinished + sought-guidance + success-criterion.
;; Host sets explicitly; no auto-fire from tensions.
(setq *dmn-oracle*
  '((:unfinished . nil)
    (:sought-guidance . nil)
    (:success-criterion . nil)
    (:set-at . nil)
    (:last-result . nil)))

(defun dmn-oracle-get ()
  "Return current oracle triple alist."
  *dmn-oracle*)

(defun dmn-oracle-set (unfinished guidance criterion)
  "Set oracle triple for a purposeful Chorus. Returns the packed oracle."
  (setq *dmn-oracle*
        (list (cons :unfinished unfinished)
              (cons :sought-guidance guidance)
              (cons :success-criterion criterion)
              (cons :set-at *now*)
              (cons :last-result nil)))
  *dmn-oracle*)

(defun dmn-oracle-clear ()
  "Clear oracle triple after interpret or abort. Returns cleared oracle."
  (setq *dmn-oracle*
        '((:unfinished . nil)
          (:sought-guidance . nil)
          (:success-criterion . nil)
          (:set-at . nil)
          (:last-result . nil)))
  *dmn-oracle*)

(defun dmn-oracle-slot (key)
  "Return value for KEY in *dmn-oracle*, or nil."
  (let ((p (assoc key *dmn-oracle*)))
    (if p (cdr p) nil)))

(defun dmn-oracle-preflight ()
  "Return (ok ...) if all three gates set, else (blocked missing-gates ...)."
  (let ((u (dmn-oracle-slot :unfinished))
        (g (dmn-oracle-slot :sought-guidance))
        (c (dmn-oracle-slot :success-criterion))
        (missing nil))
    (unless u (setq missing (cons :unfinished missing)))
    (unless g (setq missing (cons :sought-guidance missing)))
    (unless c (setq missing (cons :success-criterion missing)))
    (if missing
        (list 'blocked
              (cons :missing (nreverse missing))
              (cons :oracle *dmn-oracle*)
              (cons :instruction "Call (dmn-oracle-set unfinished guidance criterion) before Chorus."))
      (list 'ok
            (cons :unfinished u)
            (cons :sought-guidance g)
            (cons :success-criterion c)
            (cons :set-at (dmn-oracle-slot :set-at))
            (cons :instruction "Preflight ok. Run Chorus; then interpret sticky before claiming guidance.")))))

(defun dmn-oracle-candidates ()
  "Suggest oracle triples from known tensions/threads. Host still chooses via dmn-oracle-set. No auto-fire."
  (list
   (list :signal 'pure-dmn-vs-tpn-pressure
         :unfinished "pure-dmn-vs-tpn-pressure: two modes on one page; do not collapse"
         :sought-guidance "refuse collapse into one useful mode; protect dual-write and incomplete lines"
         :success-criterion "sticky maps to protect crease / unfinished shore, or explicit no-clear-guidance")
   (list :signal 'geometry-preservation
         :unfinished "geometry-preservation: what must survive rewrite of the page/session"
         :sought-guidance "protect crease, fixed star, lattice across rewrite; refuse total wipe"
         :success-criterion "sticky names something that must remain, maps to next Act or veto")
   (list :signal 'user-drive-vs-mind-drive
         :unfinished "user-drive-vs-mind-drive: initiative vs constitutional veto"
         :sought-guidance "protect HUMAN_TOOL veto; try mind-drive wave with clear stop"
         :success-criterion "sticky maps to when to stop / when to act, or no-clear-guidance")
   (list :signal 'p12-dmn-mind-native
         :unfinished "p12-dmn-mind-native: procedure still partly in docs vs mind"
         :sought-guidance "prefer mind forms as runtime authority; refuse parallel procedure trees"
         :success-criterion "sticky or next Act reduces doc-bypass; or no-clear-guidance")))
