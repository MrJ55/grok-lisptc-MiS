;; MiS helpers module — version string and known registry
(defun mis-version () "Return a version string for the mind helpers." "mis-helpers-0.6")
(defun mis-ping () "Health check." 'pong)
(defun mis-note (msg) msg)
(defun mis-register (sym) (setq *mis-known* (cons sym *mis-known*)) sym)
(setq *mis-known* '(mis-version mis-ping mis-note mis-register mis-state-summary mis-schema mis-insights update-self-schema dmn-log-episode dmn-fetch-unreflected dmn-reflect-pack dmn-apply-reflection dmn-narrate dmn-chapter-close dmn-arc dmn-autobiography audit-reality-status audit-autobiography-grounding audit-self-schema-evidence promote-candidate square triple double quadruple half))

(defun mis-state-summary ()
  "Compact state for smoke and continuity."
  (list
    (cons 'version (mis-version))
    (cons 'ping (mis-ping))
    (cons 'known *mis-known*)
    (cons 'schema *self-schema*)
    (cons 'arc *narrative-arc*)
    (cons 'auto-len (length *autobiography*))
    (cons 'buffer-len (length *episodic-buffer*))
    (cons 'manifest *mind-manifest*)
    (cons 'session *session-id*)))
