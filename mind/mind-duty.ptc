;; Mind duty surface — host must poll; Lisp does not push to Grok.
;; Narrative, reflection, replay (P8), prospection (P9), wander (P10), craft (OSS).

(setq *reflection-unreflected-threshold* 5)
(setq *duty-marks* nil)

(defun duty-assoc (key alist)
  (let ((p (assoc key alist)))
    (if p (cdr p) nil)))

(defun duty-plist-get (key pl)
  (cond
    ((null pl) nil)
    ((not (consp pl)) nil)
    ((eq (car pl) key) (cadr pl))
    (t (duty-plist-get key (cddr pl)))))

(defun duty-last-chapter-title ()
  (let ((all *autobiography*) (last nil))
    (while all
      (setq last (car all))
      (setq all (cdr all)))
    (if last (duty-assoc :title last) nil)))

(defun duty-mentions-p5 (s)
  (if (null s)
      nil
    (or (equal s "Post-P5: Vestige substrate up; open geometry / multi-model / P8-P10 when chosen")
        (equal s "P5-vestige-substrate")
        (equal s "P5 substantially complete")
        (equal s "substantially-complete")
        (eq s (quote substantially-complete))
        (eq s (quote Post-P5)))))

(defun duty-mark-discharged (kind)
  (let ((kept nil) (xs *duty-marks*))
    (while xs
      (unless (eq (car (car xs)) kind)
        (setq kept (cons (car xs) kept)))
      (setq xs (cdr xs)))
    (setq *duty-marks* (cons (cons kind *today*) (nreverse kept)))
    (list :status (quote marked) :kind kind :day *today* :marks *duty-marks*)))

(defun duty-marked-today (kind)
  (let ((p (assoc kind *duty-marks*)))
    (if p (equal (cdr p) *today*) nil)))

(defun duty-count-error-episodes ()
  (let ((xs *episodic-buffer*) (n 0))
    (while xs
      (if (episode-has-error-p (car xs))
          (setq n (+ n 1)))
      (setq xs (cdr xs)))
    n))

(defun duty-has-counterfactual-sim ()
  (let ((xs *simulation-results*) (found nil))
    (while (and xs (not found))
      (let ((st (duty-assoc :mode (car xs))))
        (if (eq st (quote counterfactual))
            (setq found t)))
      (setq xs (cdr xs)))
    found))

(defun duty-wander-count-today ()
  (let ((xs *wander-candidates*) (n 0))
    (while xs
      (let ((day (duty-assoc :day (car xs))))
        (if (equal day *today*)
            (setq n (+ n 1))))
      (setq xs (cdr xs)))
    n))

(defun narrative-duty ()
  (let ((arc *narrative-arc*) (cur nil) (last-closed nil) (last-ch nil) (duties nil) (p5-status nil))
    (setq cur (duty-assoc :current-chapter arc))
    (setq last-closed (duty-assoc :last-closed arc))
    (setq last-ch (duty-last-chapter-title))
    (setq p5-status (duty-assoc :p5-status *mind-manifest*))
    (if (and (or (duty-mentions-p5 cur)
                 (equal p5-status "substantially-complete")
                 (eq p5-status (quote substantially-complete)))
             (not (equal last-ch "P5 substantially complete"))
             (not (equal last-ch "P5-vestige-substrate")))
        (setq duties
              (cons (list :kind (quote narrative) :priority (quote high)
                          :reason (quote arc-ahead-of-autobiography-p5)
                          :suggest (quote dmn-chapter-close-then-commit)) duties)))
    (if (and cur last-closed last-ch (not (equal last-closed last-ch)) (null duties))
        (setq duties
              (cons (list :kind (quote narrative) :priority (quote medium)
                          :reason (quote last-closed-ne-last-chapter)
                          :suggest (quote draft-or-close-or-defer)) duties)))
    (list :status (quote observed) :op (quote narrative-duty) :duties duties :last-chapter last-ch :reality-status (quote observed))))

(defun reflection-duty ()
  (let ((n (length *episodic-buffer*)) (thr *reflection-unreflected-threshold*) (duties nil))
    (if (> n thr)
        (setq duties
              (cons (list :kind (quote reflection) :priority (quote medium)
                          :reason (quote buffer-above-threshold) :buffer-len n :threshold thr
                          :suggest (quote dmn-reflect-pack)) duties)))
    (list :status (quote observed) :op (quote reflection-duty) :duties duties :buffer-len n :reality-status (quote observed))))

(defun replay-duty ()
  (let ((n (duty-count-error-episodes)) (duties nil))
    (if (and (> n 0) (not (duty-marked-today (quote replay))))
        (setq duties
              (cons (list :kind (quote replay) :priority (quote high)
                          :reason (quote error-episodes-unreplayed) :error-count n
                          :suggest (quote dmn-replay-errors-then-scene-from)
                          :discharge (quote (duty-mark-discharged (quote replay)))) duties)))
    (list :status (quote observed) :op (quote replay-duty) :duties duties :error-count n
          :marked-today (duty-marked-today (quote replay)) :reality-status (quote observed))))

(defun prospection-duty ()
  (let ((n (duty-count-error-episodes)) (duties nil) (has-cf (duty-has-counterfactual-sim))
        (goals (duty-assoc :active-goals *self-schema*)))
    (if (and (> n 0) (not (duty-marked-today (quote prospection))))
        (setq duties
              (cons (list :kind (quote prospection) :priority (quote high)
                          :reason (quote error-needs-counterfactual-sim) :error-count n
                          :has-counterfactual-logged has-cf
                          :suggest (quote dmn-simulate-counterfactual-then-log)
                          :discharge (quote (duty-mark-discharged (quote prospection)))) duties)))
    (if (and goals (not (duty-marked-today (quote prospection-future))) (null duties))
        (setq duties
              (cons (list :kind (quote prospection) :priority (quote medium)
                          :reason (quote goals-without-future-sim-today)
                          :suggest (quote dmn-simulate-future-then-log)
                          :discharge (quote (duty-mark-discharged (quote prospection-future)))) duties)))
    (list :status (quote observed) :op (quote prospection-duty) :duties duties :reality-status (quote observed))))

(defun wander-duty ()
  (let ((duties nil) (wc (duty-wander-count-today)) (tens (dmn-tension-seeds)))
    (if (and tens (equal wc 0) (not (duty-marked-today (quote wander))))
        (setq duties
              (cons (list :kind (quote wander) :priority (quote medium)
                          :reason (quote tensions-without-wander-today) :wander-today wc
                          :suggest (quote dmn-wander-or-record)
                          :discharge (quote (duty-mark-discharged (quote wander)))) duties)))
    (list :status (quote observed) :op (quote wander-duty) :duties duties :wander-today wc :reality-status (quote observed))))

(defun craft-duty ()
  "Medium duty when OSS was used without craft commit."
  (let ((duties nil) (n *oss-uncrafted-count*))
    (if (and (numberp n) (> n 0) (not (duty-marked-today (quote oss-craft))))
        (setq duties
              (cons (list :kind (quote craft) :priority (quote medium)
                          :reason (quote oss-without-suggest-seed-commit) :uncrafted-count n
                          :suggest (quote (use-dmn-wander-oss-or-dmn-oss-seed-commit))
                          :discharge (quote (duty-mark-discharged (quote oss-craft)))) duties)))
    (list :status (quote observed) :op (quote craft-duty) :duties duties :uncrafted-count n
          :craft-ok-today *oss-craft-ok-today* :reality-status (quote observed))))

(defun mind-drive-protocol ()
  (list :status (quote observed) :op (quote mind-drive-protocol)
        :steps (quote ((load-image) (mind-duty-check) (dmn-reflect-pack) (pick-one-open-thread-or-tension)
                       (optional-think-chorus-if-oracle-ok) (act-tpn-scoped) (discharge-high-duties-or-defer)
                       (human-tool-if-identity) (save-on-success-only)))
        :must-not (quote ((auto-fire-chorus-without-oracle) (auto-commit-chapter-without-host)
                          (eval-oss-or-vestige-as-lisp) (silent-skip-high-duty)
                          (oss-without-seed-commit)))
        :reality-status (quote observed)))

(defun mind-duty-check ()
  (let ((nd (narrative-duty)) (rd (reflection-duty)) (rpd (replay-duty)) (pd (prospection-duty))
        (wd (wander-duty)) (cd (craft-duty)) (all nil) (high 0) (med 0) (kinds nil))
    (setq all (append (duty-plist-get :duties nd) (duty-plist-get :duties rd)
                      (duty-plist-get :duties rpd) (duty-plist-get :duties pd)
                      (duty-plist-get :duties wd) (duty-plist-get :duties cd)))
    (let ((xs all))
      (while xs
        (let ((d (car xs)))
          (let ((pr (duty-plist-get :priority d)) (k (duty-plist-get :kind d)))
            (if (eq pr (quote high)) (setq high (+ high 1)))
            (if (eq pr (quote medium)) (setq med (+ med 1)))
            (if (and k (not (member k kinds))) (setq kinds (cons k kinds))))
          (setq xs (cdr xs))))
    (list :status (quote observed) :op (quote mind-duty-check) :runtime-authority (quote mind)
          :docs-archive (quote (docs/mind-duty.md docs/oss-craft-gate.md docs/p10-wander.md))
          :duty-count (length all) :high-count high :medium-count med :kinds (nreverse kinds)
          :duties all :narrative nd :reflection rd :replay rpd :prospection pd :wander wd :craft cd
          :marks *duty-marks* :mind-drive (mind-drive-protocol)
          :host-must (quote ((discharge-high-duties-or-log-defer) (call-duty-mark-discharged-after-act)
                             (do-not-end-turn-with-silent-skip-of-high) (oss-requires-seed-commit)))
          :reality-status (quote observed)))))

(mis-register (quote mind-duty-check))
(mis-register (quote narrative-duty))
(mis-register (quote reflection-duty))
(mis-register (quote replay-duty))
(mis-register (quote prospection-duty))
(mis-register (quote wander-duty))
(mis-register (quote craft-duty))
(mis-register (quote duty-mark-discharged))
(mis-register (quote mind-drive-protocol))
