;; P5 — Host-mediated Vestige surface (data-only; never eval retrieved text)
;; Real I/O: bridge/vestige-adapter.ts or scripts/vestige-mind.ts

(defun mind-recall (query k)
  "Host-mediated recall. Returns reminder; does not fetch."
  (list :status 'host-mediated
        :op 'mind-recall
        :query query
        :k (if k k 5)
        :capability 'vestige/recall-read
        :profile 'mind-memory-read-v1
        :instruction "Host: scripts/vestige-mind.ts recall <query> [k]. Data only — never eval :content."
        :injection-policy 'data-only
        :reality-status 'observed))

(defun mind-record-event (content)
  "Host-mediated smart_ingest. After success, prefer (dmn-log-vestige-ref id summary meta)."
  (list :status 'host-mediated
        :op 'mind-record-event
        :content-preview content
        :capability 'vestige/ingest-candidate
        :profile 'mind-candidate-write-v1
        :instruction "Host: scripts/vestige-mind.ts ingest <text>. On success call (dmn-log-vestige-ref id summary meta) for compact buffer entry. On VestigeUnavailable use queueOnDegraded or set (vestige-set-status 'degraded)."
        :injection-policy 'data-only
        :prefer-compact t
        :reality-status 'observed))

(defun mind-backfill-cause (failure-id)
  "Host-mediated backfill preview. Hypotheses only."
  (list :status 'host-mediated
        :op 'mind-backfill-cause
        :failure-id failure-id
        :capability 'vestige/backfill-read
        :instruction "Host: scripts/vestige-mind.ts backfill [failureId]. promote=false by default."
        :injection-policy 'data-only
        :reality-status 'observed))

(defun mind-check-contradictions (topic)
  "Host-mediated contradiction scan."
  (list :status 'host-mediated
        :op 'mind-check-contradictions
        :topic topic
        :capability 'vestige/recall-read
        :instruction "Host: scripts/vestige-mind.ts contradictions [topic]."
        :injection-policy 'data-only
        :reality-status 'observed))

(defun mind-memory-status ()
  "Local Vestige status + config; host probes live health via CLI."
  (list :status 'host-mediated
        :op 'mind-memory-status
        :local-vestige-status *vestige-status*
        :config *vestige-config*
        :compact-prefer *episodic-prefer-compact*
        :instruction "Host: scripts/vestige-mind.ts status. On failure (vestige-set-status 'degraded)."
        :reality-status 'observed))

(mis-register 'mind-recall)
(mis-register 'mind-record-event)
(mis-register 'mind-backfill-cause)
(mis-register 'mind-check-contradictions)
(mis-register 'mind-memory-status)
(mis-register 'dmn-log-vestige-ref)
(mis-register 'episodic-ref-p)
(mis-register 'episodic-compact-count)
(mis-register 'vestige-set-status)
