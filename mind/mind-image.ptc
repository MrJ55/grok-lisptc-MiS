  '((:gmod-schema . "0.1.0")
    (:helpers-version . "0.4")
    (:lisptc-commit . "2c10ea8ed6edb16e065b746a7f52080956b895de")
    (:capability-profile . "mind-sandbox-v1")
    (:created-at . "2026-09-02T00:00:00Z")
    (:p0.1-status . "wave-2")))
(defun mis-version () "Return a version string for the mind helpers." "mis-helpers-0.4")
(defun mis-ping () "Health check." 'pong)
(defun mis-note (msg) msg)
(setq *mis-known* '(mis-version mis-ping mis-note mis-register mis-state-summary mis-schema mis-insights update-self-schema dmn-log-episode dmn-fetch-unreflected dmn-reflect-pack dmn-apply-reflection dmn-narrate dmn-chapter-close dmn-arc dmn-autobiography audit-reality-status promote-candidate square triple double quadruple half))
(defun mis-register (sym) (if (member sym *mis-known*) sym (progn (setq *mis-known* (cons sym *mis-known*)) sym)))
(defun mis-state-summary () (list (list 'version (mis-version)) (list 'ping (mis-ping)) (list 'known *mis-known*) (list 'schema *self-schema*) (list 'arc *narrative-arc*) (list 'auto-len (length *autobiography*)) (list 'manifest *mind-manifest*)))
