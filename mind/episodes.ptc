;; MiS episodic buffer + reflection (P3/P4) + P12 oracle surface on reflect-pack
(setq *episodic-buffer* nil)
(setq *episode-seq* 0)

(defun has-reality-status (meta)
  "True if META is a plist/alist that includes :reality-status."
  (if (not (consp meta))
      nil
    (let ((pair (assoc :reality-status meta)))
      (if pair t
        (let ((xs meta) (found nil))
          (while (and xs (not found))
            (if (eq (car xs) :reality-status)
                (setq found t)
              (setq xs (cdr xs))))
          found)))))

(defun dmn-log-episode (kind summary meta)
  "Append episode to *episodic-buffer* with sequential :id. META may add keys; defaults reality-status observed and recorded-at *now*."
  (setq *episode-seq* (+ *episode-seq* 1))
  (let ((base (list (cons :id *episode-seq*)
                    (cons :reality-status (quote observed))
                    (cons :recorded-at *now*)))
        (extra (if (consp meta) meta nil))
        (merged nil))
    (setq merged base)
    (while extra
      (let ((p (car extra)))
        (if (and (consp p) (not (assoc (car p) merged)))
            (setq merged (cons p merged))))
      (setq extra (cdr extra)))
    (setq *episodic-buffer*
          (cons (list kind summary merged) *episodic-buffer*))
    (if (> (length *episodic-buffer*) 40)
        (setq *episodic-buffer* (let ((xs *episodic-buffer*) (acc nil) (i 0))
                                  (while (and xs (< i 40))
                                    (setq acc (cons (car xs) acc))
                                    (setq xs (cdr xs))
                                    (setq i (+ i 1)))
                                  (nreverse acc))))
    (car *episodic-buffer*)))

(defun dmn-fetch-unreflected (n)
  "Return up to N most recent episodes (buffer is newest-first)."
  (if (or (null n) (<= n 0))
      *episodic-buffer*
    (let ((xs *episodic-buffer*) (acc nil) (i 0))
      (while (and xs (< i n))
        (setq acc (cons (car xs) acc))
        (setq xs (cdr xs))
        (setq i (+ i 1)))
      (nreverse acc))))

(defun dmn-reflect-pack (n)
  "Return schema, unreflected episodes, and oracle surface for mind-drive. Host must still dmn-oracle-set before Chorus; no auto-fire."
  (list :schema *self-schema*
        :episodes (dmn-fetch-unreflected n)
        :oracle (dmn-oracle-get)
        :oracle-preflight (dmn-oracle-preflight)
        :oracle-candidates (dmn-oracle-candidates)
        :tension-seeds (dmn-tension-seeds)
        :chorus-hint (quote set-oracle-then-chorus-if-needed-never-auto)))

(defun dmn-apply-reflection (insights summary label)
  "Append INSIGHTS to :working-insights, set :episodic-summary and :last-reflection, log a reflection episode, return state summary."
  (let ((current (let ((pair (assoc :working-insights *self-schema*)))
                   (if pair (cdr pair) nil))))
    (update-self-schema
      (list (cons :working-insights (append current insights))
            (cons :episodic-summary summary)
            (cons :last-reflection label))))
  (dmn-log-episode "reflection" summary (list :source (quote reflection) :label label :reality-status (quote inferred)))
  (mis-state-summary))

(defun audit-reality-status ()
  "Return list of episodes and autobiography chapters missing :reality-status (empty = clean)."
  (let ((issues nil) (xs *episodic-buffer*))
    (while xs
      (let ((ep (car xs)))
        (let ((meta (if (and (consp ep) (consp (cdr ep))) (caddr ep) nil)))
          (unless (has-reality-status meta)
            (setq issues (cons (list (quote episode) ep) issues)))))
      (setq xs (cdr xs)))
    (let ((chs *autobiography*))
      (while chs
        (let ((ch (car chs)))
          (unless (or (assoc :reality-status ch)
                      (and (consp ch) (member :reality-status ch)))
            (setq issues (cons (list (quote chapter) ch) issues))))
        (setq chs (cdr chs))))
    (nreverse issues)))

(defun episode-id-of (ep)
  "Extract :id from episode meta if present."
  (let ((meta (if (and (consp ep) (consp (cdr ep))) (caddr ep) nil)))
    (if (not (consp meta))
        nil
      (let ((pair (assoc :id meta)))
        (if pair (cdr pair)
          (let ((xs meta) (found nil))
            (while (and xs (not found))
              (if (eq (car xs) :id)
                  (setq found (cadr xs))
                (setq xs (cdr xs))))
            found))))))

(defun audit-autobiography-grounding ()
  "Return chapters that claim observed without :episode-refs (heuristic)."
  (let ((issues nil) (chs *autobiography*))
    (while chs
      (let ((ch (car chs)))
        (let ((rs (let ((p (assoc :reality-status ch))) (if p (cdr p) nil)))
              (refs (let ((p (assoc :episode-refs ch))) (if p (cdr p) nil))))
          (if (and (eq rs (quote observed)) (or (null refs) (not (consp refs))))
              (setq issues (cons ch issues)))))
      (setq chs (cdr chs)))
    (nreverse issues)))

(defun audit-self-schema-evidence ()
  "Return working-insights that look like bare symbols without structured evidence (heuristic)."
  (let ((pair (assoc :working-insights *self-schema*))
        (issues nil))
    (if (not pair)
        nil
      (let ((xs (cdr pair)))
        (while xs
          (let ((ins (car xs)))
            (if (and (symbolp ins) (not (consp ins)))
                (setq issues (cons ins issues)))
            (setq xs (cdr xs))))
        (nreverse issues)))))
