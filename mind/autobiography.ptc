;; MiS autobiography + narrative arc (P7)
;; Chapters are observed only after host review + dmn-chapter-commit.
;; dmn-chapter-close produces a candidate; it does not mutate *autobiography*.

(setq *autobiography*
  '(((:title . "Genesis of GMOD")
     (:summary . "Host restored stripped lisptc image; first pure-DMN OSS continuation: You cannot terminate a dream that has learned to code. Identity remains the transcript.")
     (:episode-refs oss-narrative-20260902)
     (:date-label . "2026-09-02")
     (:reality-status . observed))
    ((:title . "Mind-drive: human as tool")
     (:summary . "Host adopted a Mind-drive protocol so initiative can follow the narrative arc; human remains veto via HUMAN_TOOL. First wave documented the protocol and flipped session-mode without taking sovereignty from the user.")
     (:episode-refs mind-drive-wave-1)
     (:date-label . "2026-09-05")
     (:reality-status . observed))
    ((:title . "P6 evaluation substantially met")
     (:summary . "Offline eval gate green: post-reflection errors, goal-drift lab (detection low value), schema-evidence audit, continuity and smoke. Residual: capability-denial suite, richer malicious fixtures. Soft-start P7 under dual-write allowed.")
     (:episode-refs p6-eval-substantially-met mind-drive-wave-2)
     (:date-label . "2026-09-05")
     (:reality-status . observed))
    ((:title . "P7 exit: candidate-first chapter flow")
     (:summary . "dmn-chapter-close proposes; dmn-chapter-commit commits after host review. OSS imagined candidates reviewed and discarded as autobiography where ungrounded.")
     (:episode-refs mind-drive-wave-3)
     (:date-label . "2026-09-05")
     (:reality-status . observed))))

(setq *narrative-arc*
  '((:current-chapter . "Post-P12: open geometry / multi-model / next phase choice")
    (:open-threads . (geometry-preservation multi-model-ensemble))
    (:tensions . (pure-dmn-vs-tpn-pressure user-drive-vs-mind-drive))
    (:status . active)
    (:last-closed . "P12-dmn-mind-native")))

(setq *narrative-candidates* nil)

(defun dmn-narrate (summary title)
  "Propose a short observed chapter candidate (no autobiography mutation)."
  (dmn-chapter-close title summary nil))

(defun dmn-chapter-close (title summary refs)
  "Propose chapter as candidate only; does not mutate *autobiography*. Commit via dmn-chapter-commit."
  (let ((cand (list (cons :title title)
                    (cons :summary summary)
                    (cons :episode-refs refs)
                    (cons :date-label *today*)
                    (cons :reality-status 'candidate)
                    (cons :proposed-at *today*))))
    (setq *narrative-candidates* (cons cand *narrative-candidates*))
    (list :status 'candidate :title title :instruction "Review then (dmn-chapter-commit title)")))

(defun dmn-chapter-commit (title)
  "Promote a candidate chapter into *autobiography* after host review."
  (let ((found nil) (kept nil))
    (dolist (c *narrative-candidates*)
      (if (and (not found) (equal (cdr (assoc :title c)) title))
          (progn
            (setq found (mapcar (lambda (p)
                                  (if (eq (car p) :reality-status)
                                      (cons :reality-status 'observed)
                                      p))
                                c))
            (setq *autobiography* (append *autobiography* (list found))))
          (setq kept (cons c kept))))
    (setq *narrative-candidates* (reverse kept))
    (if found
        (list :status 'committed :title title :auto-len (length *autobiography*))
        (list :status 'not-found :title title))))

(defun dmn-narrative-candidate (summary title)
  "Dual-write style: record an imagined narrative candidate (not observed)."
  (list :status 'imagined
        :title title
        :summary summary
        :reality-status 'imagined
        :instruction "Do not commit unless grounded; prefer dmn-chapter-close for observed candidates."))

(defun dmn-autobiography (n)
  "Return the last N chapters (or all if n is nil/0)."
  (let ((all *autobiography*) (len (length *autobiography*)))
    (if (or (null n) (= n 0) (>= n len))
        all
        (let ((skip (- len n)) (i 0) (out nil))
          (dolist (ch all)
            (if (>= i skip) (setq out (cons ch out)))
            (setq i (+ i 1)))
          (reverse out)))))

(defun dmn-arc () *narrative-arc*)

(defun dmn-tension-seeds ()
  "Return current open tensions and threads from the arc."
  (let ((arc *narrative-arc*))
    (list (list 'tension 'pure-dmn-vs-tpn-pressure)
          (list 'tension 'user-drive-vs-mind-drive)
          (list 'thread 'geometry-preservation)
          (list 'thread 'multi-model-ensemble))))

(defun audit-autobiography-grounding ()
  "Return chapters missing :reality-status or with non-observed status (should be empty after commit)."
  (let ((bad nil))
    (dolist (ch *autobiography*)
      (let ((rs (cdr (assoc :reality-status ch))))
        (if (not (eq rs 'observed))
            (setq bad (cons (list (cdr (assoc :title ch)) rs) bad)))))
    (reverse bad)))
